#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Define directories to search
    dirs=(
        ~/.ghq/github.com/ItzNesbroDev
        ~/Dev
        ~
        ~/.ghq
        ~/.ghq/github.com
        ~/Code
        ~/dotfiles
    )

    # Filter for existing directories
    valid_dirs=()
    for dir in "${dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            valid_dirs+=("$dir")
        fi
    done

    selected=$(find "${valid_dirs[@]}" -mindepth 1 -maxdepth 1 -type d | sort -u | fzf --bind "enter:become(if [ -z {} ]; then echo {q}; else echo {}; fi)")
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Expand ~ to $HOME just in case
selected="${selected/#\~/$HOME}"

# If directory doesn't exist, create it
if [[ ! -d "$selected" ]]; then
    # If not an absolute path, default to ~/Dev
    if [[ "$selected" != /* ]]; then
        selected="$HOME/Dev/$selected"
    fi
    
    # Create the directory
    mkdir -p "$selected"
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

if [[ -z $TMUX ]]; then
    tmux attach-session -t $selected_name
else
    tmux switch-client -t $selected_name
fi
